AT_SETUP([sec_policy - select group with allow bucket])
OVS_VSWITCHD_START
add_of_ports br0 1 2
AT_CHECK([ovs-ofctl -O OpenFlow15 add-group br0 'group_id=1,type=select,bucket=sec_policy(id=1,verdict=allow),output:2'])
AT_CHECK([ovs-ofctl add-flow br0 'in_port=1,actions=sec_policy(id=2,verdict=allow),group:1'])
AT_CHECK([ovs-appctl ofproto/trace br0 'in_port=1,dl_src=50:54:00:00:00:05,dl_dst=50:54:00:00:00:07,dl_type=0x0800,nw_src=192.168.0.1,nw_dst=192.168.0.2'], [0], [stdout])
AT_CHECK([grep 'security policy 2 allows packet' stdout], [0], [ignore])
AT_CHECK([grep 'group:1' stdout], [0], [ignore])
AT_CHECK([grep 'selection method in use' stdout], [0], [ignore])
OVS_VSWITCHD_STOP
AT_CLEANUP

AT_SETUP([sec_policy - group table add dump delete])
OVS_VSWITCHD_START
add_of_ports br0 1 2
AT_CHECK([ovs-ofctl -O OpenFlow15 add-group br0 'group_id=5,type=all,bucket=sec_policy(id=9,verdict=allow),output:2'])
AT_CHECK([ovs-ofctl -O OpenFlow15 dump-groups br0 | grep 'sec_policy(id=9,verdict=allow)'], [0], [ignore])
AT_CHECK([ovs-ofctl -O OpenFlow15 del-groups br0])
AT_CHECK([ovs-ofctl -O OpenFlow15 dump-groups br0 | grep -c 'group_id='],
         [1], [0
])
OVS_VSWITCHD_STOP
AT_CLEANUP
