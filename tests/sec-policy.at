AT_CHECK([ovs-appctl ofproto/trace br0 'in_port=1,dl_src=50:54:00:00:00:05,dl_dst=50:54:00:00:00:07,dl_type=0x0800,nw_src=192.168.0.1,nw_dst=192.168.0.2'], [0], [stdout])
AT_CHECK([grep 'security policy 1 allows packet' stdout], [0], [ignore])
AT_CHECK([grep 'security policy 2 allows packet' stdout], [0], [ignore])
AT_CHECK([tail -1 stdout], [0], [Datapath actions: 2
])
OVS_VSWITCHD_STOP
